{
  "seed": 42,
  "data": {
    "path": "data/raw/Telco-Customer-Churn.csv",
    "splits_path": "results/splits.csv",
    "test_size": 0.2,
    "val_size": 0.2
  },
  "cv": {
    "n_folds": 5,
    "oof_seed": 43,
    "selection_metric": "pr_auc"
  },
  "threshold": {
    "criterion": "f1",
    "grid_start": 0.05,
    "grid_stop": 0.95,
    "grid_step": 0.01
  },
  "models": {
    "dummy": {},
    "logreg": {
      "C": [
        0.01,
        0.1,
        1.0,
        10.0
      ],
      "class_weight": [
        null,
        "balanced"
      ]
    },
    "random_forest": {
      "n_estimators": [
        300
      ],
      "max_depth": [
        null,
        8,
        12
      ],
      "min_samples_leaf": [
        1,
        5,
        20
      ],
      "max_features": [
        "sqrt",
        0.5
      ]
    },
    "catboost": {
      "iterations": [
        500
      ],
      "depth": [
        4,
        6
      ],
      "learning_rate": [
        0.03,
        0.1
      ],
      "l2_leaf_reg": [
        3,
        10
      ]
    }
  },
  "output": {
    "results_dir": "results",
    "figures_dir": "reports/figures",
    "artifact_path": "artifacts/churn_model.joblib"
  }
}
